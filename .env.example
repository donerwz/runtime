# --- Tiger Data (Postgres + TimescaleDB) ---
# DEV A: Fill in your Tiger Data connection string.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/volunteer_tracker

# --- Gemini ---
# DEV A: Add your Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# --- GitHub (Phase 4 only) ---
# DEV A: Personal access token with read:user and repo scopes.
GITHUB_TOKEN=your_github_token_here

# --- App ---
# DEV A: Any random string used to sign internal tokens.
SECRET_KEY=change_me_to_a_random_string
